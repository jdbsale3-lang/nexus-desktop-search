{
  "name": "ZEUS Kali-AEGIS Scan (6-tool)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kali-scan",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "trigger-webhook",
      "name": "Webhook (estate trigger)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "python3 /aegis/work/kali/kali-scan-hook.py {{ $json.target || 'https://zeusaiintelligence.com' }} --tools {{ $json.tools || 'nuclei,nmap' }}"
      },
      "id": "exec-scan",
      "name": "Execute Kali scan hook (6-tool)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [550, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse hook JSON; surface verdict + findings for downstream nodes\nconst raw = $json.stdout || '{}';\nconst parsed = JSON.parse(raw.slice(raw.indexOf('{')));\nlet findings = [];\n(parsed.results || []).forEach(r => (r.findings || []).forEach(f =>\n  findings.push({ tool: r.tool, line: f })));\nreturn [{ json: { ...parsed, findings_list: findings } }];",
        "options": {}
      },
      "id": "parse-json",
      "name": "Parse JSON + flatten findings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "options": {
          "responseData": "allEntries",
          "responseHeaders": { "entries": [{ "name": "Content-Type", "value": "application/json" }] }
        }
      },
      "id": "respond",
      "name": "Respond to Webhook (JSON)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1150, 300]
    }
  ],
  "connections": {
    "trigger-webhook": { "main": [[{ "node": "exec-scan", "type": "main", "index": 0 }]] },
    "exec-scan": { "main": [[{ "node": "parse-json", "type": "main", "index": 0 }]] },
    "parse-json": { "main": [[{ "node": "respond", "type": "main", "index": 0 }]] }
  },
  "settings": {},
  "pinData": {}
}